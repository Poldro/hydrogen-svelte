# Store domain, e.g. your-store.myshopify.com
PUBLIC_STORE_DOMAIN=
# Public Storefront API token (safe to expose to the browser)
PUBLIC_STOREFRONT_API_TOKEN=
# Private Storefront API token (server only, never expose)
PRIVATE_STOREFRONT_API_TOKEN=
# Numeric shop ID (Storefront API: `{ shop { id } }` -> gid://shopify/Shop/<id>), for ShopifyScripts
PUBLIC_SHOP_ID=
